{
  "manifest_version": 3,
  "name": "Perplexity Counter",
  "version": "0.2.0",
  "description": "Shows ~token count, remaining Pro / Research / Labs queries on perplexity.ai.",
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "css": ["src/styles.css"],
      "js": ["src/vendor/o200k_base.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
